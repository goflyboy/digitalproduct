  "validationRules": [
    {
      "apiName": "skuUniqueBySalesAttrs",
      "displayName": "SKU销售属性唯一性",
      "scope": {"objectType": "SKU"},
      "rule": "same spuId + same salesAttrsHash → only ONE sku",
      "errorMessage": "同一SPU下销售属性组合不能重复"
    },
    {
      "apiName": "categoryNoCycle",
      "displayName": "品类无环",
      "scope": {"linkType": "PARENT_OF"},
      "rule": "no cycles in category tree",
      "errorMessage": "品类层级不能形成环"
    },
    {
      "apiName": "pricePositive",
      "displayName": "价格非负",
      "scope": {"linkType": "SOLD_BY"},
      "rule": "salePrice >= 0 AND originalPrice >= 0",
      "errorMessage": "价格不能为负数"
    },
    {
      "apiName": "merchantSkuStatusTransition",
